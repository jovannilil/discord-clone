PORT=3001

# Long random string used to sign login tokens. REQUIRED in production.
JWT_SECRET=change-me-to-a-long-random-string

# OAuth 2.0 Client ID from Google Cloud Console (see README).
# Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# Username-only login for local testing. Defaults to on in dev, off when NODE_ENV=production.
# DEV_LOGIN=true

# Optional TURN server so calls work behind strict firewalls / mobile networks.
# TURN_URL=turn:your-turn-server.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
