{
  "name": "voxoria-chat-desktop",
  "productName": "Voxoria Chat",
  "version": "1.1.0",
  "description": "Desktop app for Voxoria Chat",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.discordclone.desktop",
    "productName": "Voxoria Chat",
    "files": [
      "main.js",
      "config.json",
      "loading.html",
      "offline.html",
      "icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "shortcutName": "Voxoria Chat"
    },
    "artifactName": "Voxoria-Chat-Setup.${ext}",
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "icon": "icon.png",
      "category": "Network",
      "artifactName": "Voxoria-Chat-linux.${ext}",
      "executableName": "voxoria-chat"
    },
    "appImage": {
      "artifactName": "Voxoria-Chat.AppImage"
    }
  },
  "author": {
    "name": "jovannilil",
    "email": "jovannilil@users.noreply.github.com"
  },
  "homepage": "https://desktop-vrdnin2.tail467931.ts.net"
}
